<style>
  .bg {
    --leaf-1: #7FB08F;
    --leaf-2: #5E8F6E;
    --leaf-3: #A9CBB2;
    --bark: #B9AA9B;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  :global(:root[data-theme="dark"]) .bg {
    --leaf-1: #4F6F5B;
    --leaf-2: #3E5A49;
    --leaf-3: #66806D;
    --bark: #4A443E;
  }

  .bark { fill: none; stroke: var(--bark); stroke-linecap: round; }
  .l1 { fill: var(--leaf-1); }
  .l2 { fill: var(--leaf-2); }
  .l3 { fill: var(--leaf-3); }

  .tree {
    position: absolute;
    bottom: -10px;
    width: min(300px, calc(50vw - 380px));
    height: min(88vh, 860px);
    opacity: 0.55;
    display: none;
  }
  .tree-svg { width: 100%; height: 100%; overflow: visible; }
  .tree-left { left: max(8px, calc(50% - 380px - 300px)); }
  .tree-right { right: max(8px, calc(50% - 380px - 300px)); transform: scaleX(-1); height: min(74vh, 720px); }

  @media (min-width: 1100px) {
    .tree { display: block; }
  }

  .sway {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: sway 7s ease-in-out var(--sway-delay) infinite;
  }
  @keyframes sway {
    0%, 100% { transform: rotate(-2.5deg); }
    50% { transform: rotate(2.5deg); }
  }

  .drift {
    position: absolute;
    top: 0;
    left: var(--x);
    width: var(--size);
    height: calc(var(--size) * 0.6);
    opacity: 0.5;
    animation: drift var(--dur) linear var(--delay) infinite;
  }
  @keyframes drift {
    0% { transform: translate(0, -8vh) rotate(0deg); }
    25% { transform: translate(var(--sway), 22vh) rotate(120deg); }
    50% { transform: translate(calc(var(--sway) * -0.5), 50vh) rotate(220deg); }
    75% { transform: translate(var(--sway), 78vh) rotate(330deg); }
    100% { transform: translate(0, 108vh) rotate(420deg); }
  }

  @media (max-width: 560px) {
    .drift { opacity: 0.35; }
    .drift:nth-of-type(n + 8) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sway, .drift { animation: none; }
    .drift { display: none; }
  }
</style>
