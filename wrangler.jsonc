{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibratingkoala",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "vibratingkoala.my", "custom_domain": true },
    { "pattern": "www.vibratingkoala.my", "custom_domain": true }
  ]
}
